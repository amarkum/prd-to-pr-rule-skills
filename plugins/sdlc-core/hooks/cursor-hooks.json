{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {"command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/hooks/aisdlc_hooks.py\" session-context --format cursor", "timeout": 20}
    ],
    "beforeShellExecution": [
      {"command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/hooks/aisdlc_hooks.py\" shell-guard --format cursor", "timeout": 90, "failClosed": true}
    ],
    "preToolUse": [
      {"command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/hooks/aisdlc_hooks.py\" edit-guard --format cursor", "matcher": "Write", "timeout": 20, "failClosed": true}
    ],
    "beforeMCPExecution": [
      {"command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/hooks/aisdlc_hooks.py\" pr-gate --format cursor", "timeout": 90}
    ],
    "stop": [
      {"command": "python3 \"${CURSOR_PLUGIN_ROOT:-.}/hooks/aisdlc_hooks.py\" stop-verify --format cursor", "timeout": 20, "loop_limit": 1}
    ]
  }
}
