{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/aisdlc_hooks.py", "session-context"], "timeout": 20}
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/aisdlc_hooks.py", "shell-guard"], "timeout": 90, "onFailure": "block"}
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/aisdlc_hooks.py", "edit-guard"], "timeout": 20, "onFailure": "block"}
        ]
      },
      {
        "matcher": "mcp__.*create_pull_request",
        "hooks": [
          {"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/aisdlc_hooks.py", "pr-gate"], "timeout": 90, "onFailure": "block"}
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {"type": "command", "command": "python3", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/aisdlc_hooks.py", "stop-verify"], "timeout": 20}
        ]
      }
    ]
  }
}
